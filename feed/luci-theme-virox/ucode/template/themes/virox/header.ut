{#
	Virox theme: page header. Derived from luci-theme-argon v2.4.3 (header.htm)
	Copyright 2020 Jerrykuku <jerrykuku@qq.com>, luci-theme-material Copyright 2015 Lutty Yang,
	Licensed to the public under the Apache License 2.0 (LICENSE.argon).
	Virox changes: the sidebar menu is filled by menu-virox.js (simple menu or the complete one);
	redirect to the setup wizard while root has no password; at most one compact notice per page
	(BUILD-PLAN 10a item 1); the product name in the sidebar; no "No password set!" box (the
	wizard asks for the password instead).
-#}
{%
	import { getuid, getspnam } from 'luci.core';
	import { cursor } from 'uci';

	const boardinfo = ubus.call('system', 'board');
	const hostname = striptags(boardinfo?.hostname ?? '?');
	const product = cursor().get('lg7200', 'product', 'name') ?? 'Virox';
	const page_path = length(ctx.path) > length(ctx.request_path) ? ctx.path : ctx.request_path;
	const nopass = (getuid() == 0 && getspnam('root')?.pwdp === '');
	const setup_url = dispatcher.build_url('admin/setup');
	const on_setup = (join('/', ctx.request_path) == 'admin/setup');
	const gate = (nopass && !on_setup && !blank_page && dispatcher.lookup('admin/setup'));
	include('themes/' + theme + '/head', { hostname: hostname, is_login: false });
%}
{% if (gate): %}
<script>location.replace({{ sprintf('%J', setup_url) }});</script>
{% endif %}
<body
	class="lang_{{ dispatcher.lang }} {{ node?.title ? ` - ${striptags(node.title)}` : '' }} {% if (ctx.authsession): %}logged-in{% endif %}"
	data-page="{{ entityencode(join('-', page_path), true) }}"{% if (gate): %} hidden{% endif %}>

	{% if (!blank_page): %}
	<a class="skip-link" href="#maincontent">{{ _('Skip to content', 'Virox') }}</a>
	<div class="main">
		<div class="main-left" id="mainmenu" style="display:none">
			<div class="sidenav-header d-flex align-items-center">
				<a class="brand" href="{{ dispatcher.build_url('admin') }}"><img src="{{ media }}/logo.svg" alt="" width="28" height="28"><bdi>{{ product }}</bdi></a>
			</div>
		</div>
		<div class="main-right">
			<header class="bg-primary">
				<div class="fill">
					<div class="container">
						<div class="flex1">
							<button type="button" class="showSide" aria-label="{{ entityencode(_('Main menu'), true) }}" aria-controls="mainmenu" aria-expanded="false"></button>
							<a class="brand" href="{{ dispatcher.build_url('admin') }}" title="{{ entityencode(hostname, true) }}"><bdi>{{ hostname }}</bdi></a>
						</div>
						<div class="header-actions">
							<div class="status" id="indicators"></div>
							{# language and light / dark from every page (owner, 2026-11-19) #}
							<button type="button" class="vx-hbtn" id="vx-h-lang" onclick="vxLang('{{ dispatcher.lang == 'ar' ? 'en' : 'ar' }}')" lang="{{ dispatcher.lang == 'ar' ? 'en' : 'ar' }}">{{ dispatcher.lang == 'ar' ? 'English' : 'عربي' }}</button>
							<button type="button" class="vx-hbtn vx-hbtn-icon" id="vx-h-mode" onclick="vxMode()" aria-label="{{ dispatcher.lang == 'ar' ? 'الوضع الفاتح أو الداكن' : 'Light or dark' }}" title="{{ dispatcher.lang == 'ar' ? 'الوضع الفاتح أو الداكن' : 'Light or dark' }}">
								<svg class="vx-i-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
								<svg class="vx-i-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
							</button>
						</div>
					</div>
				</div>
			</header>
			<div class="darkMask"></div>
			<main id="maincontent" tabindex="-1">
				<div class="container">
					{% include('themes/virox/notices') %}

					<noscript>
						<div class="alert-message error">
							<h4>{{ _('JavaScript required!') }}</h4>
							<p>{{ _('You must enable JavaScript in your browser or LuCI will not work properly.') }}</p>
						</div>
					</noscript>

					<div id="tabmenu" style="display:none"></div>
	{% endif %}
