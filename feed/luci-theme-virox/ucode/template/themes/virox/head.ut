{#
	Virox theme: shared document head. Derived from luci-theme-argon v2.4.3 (header.htm)
	Copyright 2020 Jerrykuku <jerrykuku@qq.com>, luci-theme-material Copyright 2015 Lutty Yang,
	Licensed to the public under the Apache License 2.0 (LICENSE.argon).
	Virox changes (BUILD-PLAN 10b): the look settings come from lg7200.ui (mode, accent, accent_dark,
	blur, transparency; defaults = the LG-7200 as delivered: light, #2563eb, #1d4ed8; blur 10 and 0.5 (Argon defaults)
	value); dark.css is put inline as Argon 2.4.3 does (auto: under prefers-color-scheme); right-
	to-left pages get dir="rtl"; the Virox stylesheet and the bundled Arabic font come after
	Argon's; no branding service, no online background; the login page loads no LuCI scripts (an
	anonymous page must not call the API, 10b item 7).
	Callers supply hostname and is_login.
-#}
{%
	import { stat, readfile, lsdir } from 'fs';
	import { pow } from 'math';
	import { cursor } from 'uci';

	let cfg = cursor();
	http.prepare_content('text/html; charset=UTF-8');

	function validColor(value, fallback) {
		return type(value) == 'string' && match(value, /^#[0-9a-fA-F]{3}([0-9a-fA-F]{3})?$/) ? value : fallback;
	}
	function validNumber(value, fallback, maximum) {
		return type(value) == 'string' && match(value, /^(0|[1-9][0-9]*)(\.[0-9]+)?$/) && +value <= maximum ? value : fallback;
	}

	// ---- the colour tokens (virox-ui-ux-guideline.md sections 3 and 8): a base theme gives the
	// neutrals and the default accent; the accent the owner chose drives every accent surface, with
	// its strong / soft / line / ink shades worked out here, so the first paint has the right colours
	// and the dark mode never falls back to blue (the old accent_dark gap).
	const BASES = {
		virox: { accent: [ '#0b7a5f', '#4fd1a8' ],
			light: { bg: '#f6f5f1', surface: '#ffffff', raised: '#ffffff', sunken: '#efede7', strong: '#121a1c', text: '#2a3438', muted: '#65727a', border: '#e2dfd7', border2: '#c9c4b9', track: '#e7e4dc' },
			dark: { bg: '#0d1316', surface: '#151d21', raised: '#1b252b', sunken: '#0a0f12', strong: '#f1f6f7', text: '#d3dde1', muted: '#8fa0a8', border: '#28353c', border2: '#3a4a53', track: '#223038' } },
		slate: { accent: [ '#2563eb', '#7aa7ff' ], radius: [ '12px', '10px' ],
			light: { bg: '#f4f6f8', surface: '#ffffff', raised: '#ffffff', sunken: '#eaeef2', strong: '#0f172a', text: '#243044', muted: '#5b6b7f', border: '#dfe5ec', border2: '#c4ced9', track: '#e4eaf1' },
			dark: { bg: '#0b1220', surface: '#131c2b', raised: '#1a2536', sunken: '#080e18', strong: '#f0f4fa', text: '#cfdae8', muted: '#8ca0b8', border: '#26344a', border2: '#3a4c66', track: '#1e2b3d' } },
		sand: { accent: [ '#b4552d', '#f0a06a' ],
			light: { bg: '#faf6ef', surface: '#fffdf9', raised: '#fffdf9', sunken: '#f2ebdd', strong: '#241c14', text: '#3d3227', muted: '#7a6a58', border: '#e8dfd0', border2: '#d3c5af', track: '#ede4d5' },
			dark: { bg: '#14100c', surface: '#1e1813', raised: '#28201a', sunken: '#0f0b08', strong: '#faf3e9', text: '#e4d7c6', muted: '#ae9c86', border: '#382e24', border2: '#4e4032', track: '#2a2118' } }
	};
	// status colours do not follow the accent (section 3.6): light, then dark
	const STATUS = [
		'--vx-success:#12734a;--vx-success-soft:#e6f4ec;--vx-warning:#8a5600;--vx-warning-soft:#fbf1de;--vx-danger:#b3261e;--vx-danger-soft:#fceae8;--vx-info:#1d5fa8;--vx-info-soft:#e8f0fa;--vx-scrim:rgba(18,26,28,.48);' +
		'--vx-shadow-card:0 1px 2px rgba(18,26,28,.04),0 8px 24px rgba(18,26,28,.05);--vx-shadow-pop:0 8px 16px rgba(18,26,28,.08),0 24px 48px rgba(18,26,28,.12);',
		'--vx-success:#5bd68f;--vx-success-soft:#0c2a1b;--vx-warning:#f2b24c;--vx-warning-soft:#2c2109;--vx-danger:#ff8a80;--vx-danger-soft:#33110f;--vx-info:#8ab8f0;--vx-info-soft:#0d1f33;--vx-scrim:rgba(0,0,0,.64);' +
		'--vx-shadow-card:none;--vx-shadow-pop:0 24px 48px rgba(0,0,0,.5);'
	];
	function rgb(h) {
		h = lc(h);
		if (length(h) == 4) h = '#' + substr(h, 1, 1) + substr(h, 1, 1) + substr(h, 2, 1) + substr(h, 2, 1) + substr(h, 3, 1) + substr(h, 3, 1);
		return [ hex(substr(h, 1, 2)), hex(substr(h, 3, 2)), hex(substr(h, 5, 2)) ];
	}
	function hexOf(c) { return sprintf('#%02x%02x%02x', c[0], c[1], c[2]); }
	// p = share of b
	function mix(a, b, p) {
		const x = rgb(a), y = rgb(b);
		return hexOf(map([ 0, 1, 2 ], i => int(x[i] * (1 - p) + y[i] * p + 0.5)));
	}
	function luminance(h) {
		const c = map(rgb(h), v => { v = v / 255.0; return v <= 0.04045 ? v / 12.92 : pow((v + 0.055) / 1.055, 2.4); });
		return 0.2126 * c[0] + 0.7152 * c[1] + 0.0722 * c[2];
	}
	function contrast(a, b) {
		const l1 = luminance(a), l2 = luminance(b);
		return (max(l1, l2) + 0.05) / (min(l1, l2) + 0.05);
	}
	function tokens(n, accent, dark) {
		let strong, soft, line, on;
		if (dark) {
			// a dark accent is lifted until it reads on the dark canvas
			for (let i = 0; i < 10 && luminance(accent) < 0.30; i++) accent = mix(accent, '#ffffff', 0.12);
			strong = mix(accent, '#ffffff', 0.18); soft = mix(n.surface, accent, 0.14); line = mix(n.surface, accent, 0.42);
			on = contrast(accent, '#08130f') >= 4.5 ? '#08130f' : '#ffffff';
		}
		else {
			strong = mix(accent, '#000000', 0.16); soft = mix(n.surface, accent, 0.10); line = mix(n.surface, accent, 0.38);
			on = contrast(accent, '#ffffff') >= 4.5 ? '#ffffff' : '#08130f';
		}
		const focus = contrast(accent, n.bg) >= 3 ? accent : strong;
		// the hero of Home: an accent block in light mode, a quiet surface with an accent edge in dark
		const hero = dark ? sprintf('--vx-hero-bg:%s;--vx-hero-text:%s;--vx-hero-muted:%s;--vx-hero-edge:%s;', n.raised, n.strong, n.muted, accent)
			: sprintf('--vx-hero-bg:linear-gradient(135deg,%s,%s);--vx-hero-text:%s;--vx-hero-muted:%s;--vx-hero-edge:transparent;', strong, accent, on, on);
		return sprintf('--vx-bg:%s;--vx-surface:%s;--vx-surface-raised:%s;--vx-surface-sunken:%s;--vx-text-strong:%s;--vx-text:%s;--vx-text-muted:%s;' +
			'--vx-border:%s;--vx-border-strong:%s;--vx-track:%s;--vx-accent:%s;--vx-accent-strong:%s;--vx-accent-soft:%s;--vx-accent-line:%s;' +
			'--vx-on-accent:%s;--vx-focus:%s;%s%s' +
			// Argon's own colour roles follow the same tokens, so its pages match ours
			'--primary:%s;--background-color:%s;--surface-color:%s;--surface-raised:%s;--text-color:%s;--text-strong:%s;--muted-text:%s;' +
			'--border-color:%s;--border-muted:%s;--link-color:%s;--accent-text:%s;--focus-ring:%s;',
			n.bg, n.surface, n.raised, n.sunken, n.strong, n.text, n.muted, n.border, n.border2, n.track, accent, strong, soft, line,
			on, focus, hero, STATUS[dark ? 1 : 0],
			accent, n.bg, n.surface, n.raised, n.text, n.strong, n.muted, n.border, n.border, dark ? accent : strong, on, focus);
	}

	const ui = cfg.get_all('lg7200', 'ui') ?? {};
	let mode = (ui.mode in [ 'normal', 'light', 'dark' ]) ? ui.mode : 'light';
	const base = (ui.base in keys(BASES)) ? ui.base : 'slate';   // the default base (owner 2026-11-23: blue)
	const B = BASES[base];
	let primary = validColor(ui.accent, B.accent[0]);
	// the dark accent: the base's own when the accent is the base default, else the stored one (older
	// units), else the chosen accent itself (lifted in tokens())
	let dark_primary = (lc(primary) == B.accent[0]) ? B.accent[1] : validColor(ui.accent_dark, primary);
	let blur_radius = validNumber(ui.blur, '10', 100);
	let blur_opacity = validNumber(ui.transparency, '0.5', 1);
	const dark_css = (mode != 'light') ? (readfile('/www' + media + '/css/dark.css') ?? '') : '';
	const radius = B.radius ? sprintf('--vx-radius-lg:%s;--vx-radius-md:%s;', B.radius[0], B.radius[1]) : '';
	const roles = tokens(B.light, primary, false) + radius + '--field-gap:1rem;--section-inset:1.25rem;--radius-card:var(--vx-radius-md);';
	const roles_dark = tokens(B.dark, dark_primary, true);
	const bar_color = mode == 'dark' ? match(roles_dark, /--vx-accent:(#[0-9a-f]+)/)[1] : primary;
	dark_primary = match(roles_dark, /--vx-accent:(#[0-9a-f]+)/)[1];
	const rtl = (dispatcher.lang in [ 'ar', 'fa', 'he', 'ur' ]);

	const css_stat = stat('/www' + media + '/css/cascade.css');
	const css_version = css_stat ? sprintf('%d-%d', css_stat.mtime, css_stat.size) : '0';
	const vx_stat = stat('/www' + media + '/virox.css');
	const vx_version = vx_stat ? sprintf('%d-%d', vx_stat.mtime, vx_stat.size) : '0';
	// the browser keeps every page file under one version tag (?v=): with the LuCI version alone
	// it never changed between our updates, so an updated page ran with an old helper file (owner
	// 2026-11-20). The tag now carries the newest change time of our page files and styles.
	let res_mtime = 0;
	for (let d in [ '/www/luci-static/resources/view/homenet', '/www/luci-static/resources/view/lg7200',
	                '/www/luci-static/resources/homenet', '/www/luci-static/resources/virox',
	                '/www/luci-static/virox', '/www/luci-static/virox/css', '/usr/lib/lua/luci/i18n' ])
		for (let n in (lsdir(d) ?? [])) {
			const s = stat(d + '/' + n);
			if (s && s.mtime > res_mtime) res_mtime = s.mtime;
		}
	// the build gives every file the same fixed date (reproducible builds), so between two
	// versions the change time alone stays the same: the product version is part of the tag too
	// (found before 0.9.0-rc3, 2026-11-22)
	const pv = match(readfile('/etc/lg7200-release') ?? '', /PRODUCT_VERSION='?([A-Za-z0-9.-]+)/);
	const res_version = sprintf('%s-%s-%d', version.luciversion, pv ? pv[1] : '0', res_mtime);
-%}
<!DOCTYPE html>
<html lang="{{ dispatcher.lang }}" dir="{{ rtl ? 'rtl' : 'ltr' }}" data-argon-mode="{{ mode }}" data-theme="{{ base }}">

<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<title>{{ hostname }}{{ node?.title ? ` | ${striptags(_(node.title))}` : '' }}</title>
	<meta name="robots" content="noindex, nofollow">
	<meta http-equiv="Referrer-Policy" content="strict-origin-when-cross-origin">
	<meta name="darkreader-lock">
	{% if (mode == 'normal'): %}
	<meta name="theme-color" media="(prefers-color-scheme: light)" content="{{ primary }}">
	<meta name="theme-color" media="(prefers-color-scheme: dark)" content="{{ dark_primary }}">
	{% else %}
	<meta name="theme-color" content="{{ bar_color }}">
	{% endif %}
	<link rel="icon" href="{{ media }}/logo.svg" sizes="any">
	<link rel="stylesheet" href="{{ media }}/css/cascade.css?v={{ css_version }}">
	<link rel="stylesheet" href="{{ media }}/virox.css?v={{ vx_version }}">
	<style title="text/css">
		:root { --dark-primary: {{ dark_primary }}; --blur-radius:{{ blur_radius }}px; --blur-opacity:{{ blur_opacity }};
			--blur-radius-dark:{{ blur_radius }}px; --blur-opacity-dark:{{ blur_opacity }}; {{ roles }} }
		{% if (mode == 'normal'): %}
		@media (prefers-color-scheme: dark) { {{ dark_css }} :root { {{ roles_dark }} } }
		{% elif (mode == 'dark'): %}
		{{ dark_css }} :root { {{ roles_dark }} }
		{% endif %}
	</style>
	<link rel="stylesheet" href="{{ media }}/css/home-look.css?v={{ res_version }}">
	{% if (node?.css): %}
	<link rel="stylesheet" href="{{ resource }}/{{ node.css }}">
	{% endif -%}
	{% if (css): %}
	<style title="text/css">
		{{ css }}
	</style>
	{% endif -%}
	{% if (!is_login): %}
	<script src="{{ dispatcher.build_url('admin/translations', dispatcher.lang) }}?v={{ res_version }}"></script>
	<script src="{{ resource }}/cbi.js?v={{ res_version }}"></script>
	{#- the page's translation list carries every catalog's entry and the last one wins there, so an
	    entry the upstream Arabic catalog gets wrong would hide ours; the server finds ours first
	    (lg7200-setup sorts after base), so its answer goes into the list again (owner 2026-11-20) #}
	<script>if (window.TR) { {% for (let s in [ 'Apply unchecked' ]): %}TR[sfh({{ sprintf('%J', s) }})] = {{ sprintf('%J', _(s)) }}; {% endfor %}}</script>
	<script src="{{ resource }}/luci.js?v={{ res_version }}"></script>
	{% endif %}
</head>
