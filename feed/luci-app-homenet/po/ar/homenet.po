msgctxt "Virox"
msgid "Settings"
msgstr "الإعدادات"

msgid "My devices"
msgstr "أجهزتي"

msgid "Simple menu"
msgstr "القائمة البسيطة"

msgid "Advanced settings"
msgstr "الإعدادات المتقدمة"

msgid "This device or person no longer exists."
msgstr "هذا الجهاز أو الشخص لم يعد موجودًا."

msgid "This device no longer exists (it may have been merged or removed)."
msgstr "هذا الجهاز لم يعد موجودًا (ربما تم دمجه أو حذفه)."

msgid "This person no longer exists."
msgstr "هذا الشخص لم يعد موجودًا."

msgid "Type a name."
msgstr "اكتب اسمًا."

msgid "The name is too long: at most 40 characters."
msgstr "الاسم طويل: 40 حرفًا على الأكثر."

msgid "There is already a person with this name."
msgstr "يوجد شخص آخر بالاسم نفسه."

msgid "This is the same device."
msgstr "هذا هو الجهاز نفسه."

msgid "This duration is not allowed."
msgstr "هذه المدة غير مسموح بها."

msgid "This device is not waiting for approval."
msgstr "هذا الجهاز ليس بانتظار الموافقة."

msgid "Unknown choice."
msgstr "اختيار غير معروف."

msgid "An error was stopped before it could delete data. Nothing changed."
msgstr "تم إيقاف خطأ قبل أن يحذف بيانات. لم يتغير شيء."

msgid "There is no earlier version to go back to."
msgstr "لا توجد نسخة سابقة للرجوع إليها."

msgid "Choose at least one day."
msgstr "اختر يومًا واحدًا على الأقل."

msgid "Write the time like 21:30."
msgstr "اكتب الوقت بهذا الشكل: 21:30."

msgid "Start and end cannot be the same time."
msgstr "لا يمكن أن تكون البداية والنهاية في الوقت نفسه."

msgid "The list is full."
msgstr "القائمة ممتلئة."

msgid "This schedule no longer exists."
msgstr "هذا الجدول لم يعد موجودًا."

msgid "Type the package size in GB (0 to 100000)."
msgstr "اكتب حجم الباقة بالجيجا (من 0 إلى 100000)."

msgid "The renewal day is 1 to 31."
msgstr "يوم التجديد من 1 إلى 31."

msgid "The warning is 50 % to 100 %."
msgstr "التنبيه من 50% إلى 100%."

msgid "Use 1 to 10000 KB."
msgstr "اكتب رقمًا من 1 إلى 10000 كيلوبايت."

msgid "Speed is 0.1 to 1000 Mbit/s, or 0 for no limit."
msgstr "السرعة من 0.1 إلى 1000 ميجابت/ث، أو 0 بلا حد."

msgid "Type the limit in GB."
msgstr "اكتب الحد بالجيجا."

msgid "The remaining amount is larger than the package."
msgstr "المتبقي أكبر من حجم الباقة."

msgid "Set the package size first."
msgstr "حدد حجم الباقة أولًا."

msgid "The router clock is not set yet. Try again in a few minutes."
msgstr "ساعة الراوتر لم تُضبط بعد. حاول مرة أخرى بعد دقائق."

msgid "This value is not allowed."
msgstr "هذه القيمة غير مسموح بها."

msgid "Type a site name like example.com"
msgstr "اكتب اسم موقع مثل example.com"

msgid "Unknown site."
msgstr "موقع غير معروف."

msgid "Choose a site or type one."
msgstr "اختر موقعًا أو اكتب اسمه."

msgid "This lock has already ended."
msgstr "هذا الحظر انتهى بالفعل."

msgid "Unknown list size."
msgstr "حجم القائمة غير معروف."

msgid "The start signal could not be sent."
msgstr "تعذّر إرسال إشارة التشغيل."

msgid "This device number (MAC) is not valid."
msgstr "رقم الجهاز (MAC) غير صحيح."

msgid "This device number (MAC) is not known."
msgstr "رقم الجهاز (MAC) هذا غير معروف."

msgid "Use 3 to 16 small English letters, digits or _, starting with a letter."
msgstr "من 3 إلى 16 حرفًا: حروف إنجليزية صغيرة أو أرقام أو _، ويبدأ بحرف."

msgid "Use 8 to 64 characters for the password."
msgstr "كلمة المرور من 8 إلى 64 حرفًا."

msgid "This user name is taken."
msgstr "اسم المستخدم هذا محجوز لحساب آخر."

msgid "This user no longer exists."
msgstr "هذا الحساب لم يعد موجودًا."

msgid "The password could not be saved. Try again."
msgstr "تعذّر حفظ كلمة المرور. حاول مرة أخرى."

msgid "This part is not installed on this router."
msgstr "هذا الجزء غير مثبت على هذا الراوتر."

msgid "Type a valid address."
msgstr "اكتب عنوانًا صحيحًا."

msgid "This address is not in the home network."
msgstr "هذا العنوان ليس من شبكة المنزل."

msgid "This is the address of the router itself."
msgstr "هذا عنوان الراوتر نفسه."

msgid "This address is reserved for the network."
msgstr "هذا العنوان محجوز للشبكة."

msgid "This address is reserved for another device."
msgstr "هذا العنوان محجوز لجهاز آخر."

msgid "This device already has a fixed address."
msgstr "هذا الجهاز له عنوان ثابت بالفعل."

msgid "Another device uses this address now."
msgstr "جهاز آخر يستخدم هذا العنوان الآن."

msgid "This setting stopped address handout, so the last working settings were put back."
msgstr "هذا الإعداد أوقف توزيع العناوين، فتمت إعادة آخر إعدادات كانت تعمل."

msgid "Address handout is stopped and there are no working settings to go back to."
msgstr "توزيع العناوين متوقف ولا توجد إعدادات سابقة تعمل للرجوع إليها."

msgid "Something went wrong. Try again."
msgstr "حدثت مشكلة. حاول مرة أخرى."

msgid "Loading…"
msgstr "جارٍ التحميل…"

msgid "The router did not answer. Check that you are still connected to it, then reload the page."
msgstr "لم يرد الراوتر. تأكد أنك ما زلت متصلًا به، ثم أعد تحميل الصفحة."

msgid "Reload"
msgstr "إعادة التحميل"

msgid "The router did not answer."
msgstr "لم يرد الراوتر."

msgid "Cancel"
msgstr "إلغاء"

msgid "Yes"
msgstr "نعم"

msgid "%s (all devices)"
msgstr "%s (كل أجهزته)"

msgid "Unnamed device"
msgstr "جهاز بدون اسم"

msgid "Choose…"
msgstr "اختر…"

msgid "Sun"
msgstr "الأحد"

msgid "Mon"
msgstr "الاثنين"

msgid "Tue"
msgstr "الثلاثاء"

msgid "Wed"
msgstr "الأربعاء"

msgid "Thu"
msgstr "الخميس"

msgid "Fri"
msgstr "الجمعة"

msgid "Sat"
msgstr "السبت"

msgid "For example: bedtime"
msgstr "مثلًا: وقت النوم"

msgid "In force now"
msgstr "الإيقاف سارٍ الآن"

msgid "Switch off"
msgstr "إيقاف الجدول"

msgid "Switch on"
msgstr "تشغيل الجدول"

msgid "Removed."
msgstr "تم الحذف."

msgctxt "Virox"
msgid "Remove"
msgstr "حذف"

msgid "No internet on the chosen days between the two times. An end before the start runs past midnight."
msgstr "ينقطع الإنترنت في الأيام المختارة بين الوقتين. إذا كانت النهاية قبل البداية فالإيقاف يستمر بعد منتصف الليل."

msgid "No schedule yet."
msgstr "لا توجد جداول بعد."

msgid "New schedule"
msgstr "جدول إيقاف جديد"

msgid "For"
msgstr "يُطبق على"

msgid "Days"
msgstr "الأيام"

msgid "From"
msgstr "من"

msgid "To"
msgstr "إلى"

msgid "Name (optional)"
msgstr "الاسم (اختياري)"

msgid "Added."
msgstr "تمت الإضافة."

msgctxt "Virox"
msgid "Add"
msgstr "إضافة"

msgid "%s a day"
msgstr "%s في اليوم"

msgid "used today:"
msgstr "المستخدم اليوم:"

msgid "Used up"
msgstr "انتهى الوقت"

msgid "No daily time limit yet."
msgstr "لا يوجد وقت يومي محدد بعد."

msgid "New daily time"
msgstr "وقت يومي جديد"

msgid "Minutes per day"
msgstr "الدقائق في اليوم"

msgid "Saved."
msgstr "تم الحفظ."

msgid "Save"
msgstr "حفظ"

msgid "What counts as a minute of use"
msgstr "متى تُحسب دقيقة الاستخدام"

msgid "A minute counts only when the device moved more than this much data in it. Phones send small amounts in the background all the time; those minutes do not count."
msgstr "تُحسب الدقيقة فقط إذا نقل الجهاز فيها بيانات أكثر من هذه الكمية. الهواتف ترسل كميات صغيرة في الخلفية طوال الوقت، وهذه الدقائق لا تُحسب."

msgid "KB in a minute (normally 40)"
msgstr "كيلوبايت في الدقيقة (القيمة المعتادة 40)"

msgid "Set these per device or person on the Devices page, under More."
msgstr "تُضبط لكل جهاز أو شخص من صفحة «الأجهزة»، ثم «المزيد»."

msgid "Speed limits"
msgstr "حدود السرعة"

msgid "No speed limit."
msgstr "لا يوجد حد للسرعة."

msgid "Usage limits per cycle"
msgstr "حدود الاستهلاك لكل دورة"

msgid "Reached"
msgstr "وصل إلى الحد"

msgid "No usage limit."
msgstr "لا يوجد حد للاستهلاك."

msgid "Safe search, YouTube in restricted mode, the kids list below closed, and the usual ways around the filter closed (other DNS servers, encrypted DNS)."
msgstr "البحث الآمن، ويوتيوب في الوضع المقيّد، وحظر مواقع قائمة الأطفال أدناه، وسد الطرق المعروفة لتجاوز الفلتر (خوادم DNS أخرى وDNS المشفر)."

msgid "Kids mode is off."
msgstr "تم إيقاف وضع الأطفال."

msgid "Turn off"
msgstr "إيقاف"

msgid "No device in kids mode."
msgstr "لا يوجد جهاز في وضع الأطفال."

msgid "Kids mode is on."
msgstr "تم تشغيل وضع الأطفال."

msgid "Tip: choose \"Ask me first\" for new devices, so a new device number does not get around the rules."
msgstr "نصيحة: اختر «اسألني أولًا» للأجهزة الجديدة، حتى لا يتجاوز الطفل القواعد برقم جهاز جديد."

msgid "Turn on"
msgstr "تشغيل"

msgid "Sites closed for kids only"
msgstr "مواقع محظورة على الأطفال فقط"

msgid "None."
msgstr "لا شيء."

msgid "Close this site"
msgstr "حظر هذا الموقع"

msgid "Start a temporary block on the Devices page, under More. It ends by itself."
msgstr "ابدأ الحظر المؤقت من صفحة «الأجهزة»، ثم «المزيد». ينتهي الحظر المؤقت تلقائيًا في موعده."

msgid "%s left"
msgstr "المتبقي %s"

msgid "Unlocked."
msgstr "تم إنهاء الحظر."

msgid "Unlock"
msgstr "إنهاء الحظر"

msgid "No site is locked now."
msgstr "لا توجد مواقع محظورة مؤقتًا الآن."

msgid "Small (fewest names, least memory)"
msgstr "صغيرة (أقل عدد من المواقع وأقل ذاكرة)"

msgid "Normal (recommended)"
msgstr "عادية (موصى بها)"

msgid "Large"
msgstr "كبيرة"

msgid "Very large (needs the most memory)"
msgstr "كبيرة جدًا (تحتاج أكبر قدر من الذاكرة)"

msgid "download failed, will retry"
msgstr "فشل التحميل، وستتم إعادة المحاولة"

msgid "downloading…"
msgstr "جارٍ التحميل…"

msgid "Applies to every device in the house. The lists are downloaded by the router and refreshed every night."
msgstr "يُطبق على كل أجهزة المنزل. يحمّل الراوتر القوائم ويحدّثها كل ليلة."

msgid "Ads, trackers and harmful sites"
msgstr "الإعلانات والتتبع والمواقع الضارة"

msgid "List size"
msgstr "حجم القائمة"

msgid "The router memory is low, so a smaller list is in use for now."
msgstr "ذاكرة الراوتر منخفضة، لذلك تُستخدم قائمة أصغر حاليًا."

msgid "Adult sites"
msgstr "مواقع البالغين"

msgid "Gambling sites"
msgstr "مواقع القمار"

msgid "Ways around the filter (VPN, proxy, encrypted DNS services)"
msgstr "طرق تجاوز الفلتر (VPN والبروكسي وخدمات DNS المشفر)"

msgid "Safe search for everyone"
msgstr "البحث الآمن للجميع"

msgid "YouTube restricted mode for everyone"
msgstr "يوتيوب في الوضع المقيّد للجميع"

msgid "Saved. The lists are being prepared; this takes a minute or two."
msgstr "تم الحفظ. يتم تجهيز القوائم، وقد يستغرق ذلك دقيقة أو دقيقتين."

msgid "The last list could not be loaded; the filter kept its previous state."
msgstr "تعذّر تحميل آخر قائمة، وبقي الفلتر على حالته السابقة."

msgid "My own list"
msgstr "قائمتي"

msgid "Closed."
msgstr "تم الحظر."

msgid "Always open."
msgstr "سيبقى مسموحًا دائمًا."

msgid "Never close this site"
msgstr "السماح دائمًا"

msgid "Closed"
msgstr "محظور"

msgid "Always open"
msgstr "مسموح دائمًا"

msgid "Now: a new device gets no internet until you allow it."
msgstr "الإعداد الحالي: الجهاز الجديد لا يحصل على إنترنت حتى توافق عليه."

msgid "Now: every new device gets internet at once."
msgstr "الإعداد الحالي: أي جهاز جديد يحصل على الإنترنت فورًا."

msgid "\"Ask me first\" stops a child from getting around the rules with a new device number. Every device connected now stays allowed."
msgstr "«اسألني أولًا» يمنع الطفل من تجاوز القواعد برقم جهاز جديد. كل الأجهزة المتصلة الآن تبقى مسموحًا لها."

msgid "Let new devices in at once"
msgstr "السماح للأجهزة الجديدة فورًا"

msgid "Ask me first"
msgstr "اسألني أولًا"

msgid "Schedules"
msgstr "جداول الإيقاف"

msgid "Daily time"
msgstr "الوقت اليومي"

msgid "Limits"
msgstr "الحدود"

msgid "Kids mode"
msgstr "وضع الأطفال"

msgid "Site locks"
msgstr "الحظر المؤقت للمواقع"

msgid "House filter"
msgstr "فلتر المنزل"

msgid "New devices"
msgstr "الأجهزة الجديدة"

msgid "Waiting for approval"
msgstr "بانتظار الموافقة"

msgid "Blocked"
msgstr "محظور"

msgid "Paused until"
msgstr "متوقف مؤقتًا حتى"

msgid "Off by schedule"
msgstr "متوقف حسب الجدول"

msgid "Daily time used up"
msgstr "انتهى الوقت اليومي"

msgid "Time left today:"
msgstr "الوقت المتبقي اليوم:"

msgid "Usage limit reached"
msgstr "وصل إلى حد الاستهلاك"

msgid "Sites locked"
msgstr "مواقع محظورة مؤقتًا"

msgid "Speed limited"
msgstr "السرعة محددة"

msgid "Online (Wi-Fi)"
msgstr "متصل (واي فاي)"

msgid "Online (cable)"
msgstr "متصل (كابل)"

msgid "Offline"
msgstr "غير متصل"

msgid "Belongs to"
msgstr "يخص"

msgid "Today"
msgstr "اليوم"

msgid "This cycle"
msgstr "منذ آخر تجديد"

msgid "Allowed."
msgstr "تم السماح."

msgid "Allow"
msgstr "السماح"

msgid "Internet is back."
msgstr "عاد الإنترنت."

msgid "Resume"
msgstr "استئناف"

msgid "Pause"
msgstr "إيقاف مؤقت"

msgid "Unblocked."
msgstr "تم إلغاء الحظر."

msgid "Unblock"
msgstr "إلغاء الحظر"

msgid "Block %s?"
msgstr "حظر %s؟"

msgid "This device will have no internet until you unblock it."
msgstr "لن يحصل هذا الجهاز على إنترنت حتى تلغي الحظر."

msgid "Block"
msgstr "حظر"

msgid "Blocked."
msgstr "تم الحظر."

msgid "More"
msgstr "المزيد"

msgid "Pause %s"
msgstr "إيقاف %s مؤقتًا"

msgid "No internet for:"
msgstr "بدون إنترنت لمدة:"

msgid "Paused."
msgstr "تم الإيقاف المؤقت."

msgid "Until midnight"
msgstr "حتى منتصف الليل"

msgid "Nobody"
msgstr "لا أحد"

msgctxt "Virox"
msgid "Name"
msgstr "الاسم"

msgid "Remove %s?"
msgstr "حذف %s؟"

msgid "The devices stay; only the person and the settings made for the person are removed."
msgstr "تبقى الأجهزة، ويُحذف الشخص فقط مع الإعدادات الخاصة به."

msgid "Remove person"
msgstr "حذف الشخص"

msgid "Speed limit"
msgstr "حد السرعة"

msgid "One limit shared by all devices of this person. Empty or 0 = no limit."
msgstr "حد واحد مشترك لكل أجهزة هذا الشخص. اتركه فارغًا ليكون بلا حد."

msgid "Empty or 0 = no limit."
msgstr "اتركه فارغًا ليكون بلا حد."

msgid "Download (Mbit/s)"
msgstr "التحميل (ميجابت في الثانية)"

msgid "Upload (Mbit/s)"
msgstr "الرفع (ميجابت في الثانية)"

msgid "Usage limit per cycle"
msgstr "حد الاستهلاك لكل دورة"

msgid "Used:"
msgstr "المستخدم:"

msgid "Limit (GB), empty or 0 = no limit"
msgstr "الحد بالجيجا، اتركه فارغًا ليكون بلا حد"

msgid "Warn me at"
msgstr "نبّهني عند"

msgid "Daily internet time"
msgstr "وقت الإنترنت اليومي"

msgid "Only minutes with real use count; a phone lying idle does not use the time."
msgstr "تُحسب فقط الدقائق التي فيها استخدام فعلي، والهاتف المتروك دون استخدام لا يستهلك من الوقت."

msgid "Minutes per day, empty or 0 = no limit"
msgstr "الدقائق في اليوم، اتركه فارغًا ليكون بلا حد"

msgid "Safe search on Google, Bing and DuckDuckGo, YouTube in restricted mode, adult and kids-blocked sites closed, and the usual ways around the filter closed."
msgstr "البحث الآمن في جوجل وبينج وداك داك جو، ويوتيوب في الوضع المقيّد، وحظر مواقع البالغين ومواقع قائمة الأطفال، وسد الطرق المعروفة لتجاوز الفلتر."

msgid "On through the person."
msgstr "مفعّل عن طريق الشخص."

msgid "Tip: a child can get around the rules by letting the phone show a new device number. On the Control page, under New devices, choose \"Ask me first\"."
msgstr "نصيحة: قد يتجاوز الطفل القواعد إذا ظهر هاتفه برقم جهاز جديد. من صفحة «التحكم»، قسم «الأجهزة الجديدة»، اختر «اسألني أولًا»."

msgid "Lock sites for a while"
msgstr "حظر مواقع لفترة"

msgid "Choose sites"
msgstr "اختر المواقع"

msgid "Or type a site"
msgstr "أو اكتب اسم موقع"

msgid "Locked."
msgstr "تم الحظر."

msgid "Lock"
msgstr "حظر"

msgid "Device details"
msgstr "تفاصيل الجهاز"

msgid "Start signal sent."
msgstr "تم إرسال إشارة التشغيل."

msgid "Switch on (Wake-on-LAN)"
msgstr "تشغيل الجهاز عن بُعد"

msgid "Fixed address (empty = automatic)"
msgstr "عنوان ثابت (اتركه فارغًا ليكون تلقائيًا)"

msgid "Save address"
msgstr "حفظ العنوان"

msgid "This is the same device as"
msgstr "هذا الجهاز هو نفسه:"

msgid "For a phone that came back with a new device number: its usage and settings move to the chosen device."
msgstr "لهاتف عاد برقم جهاز جديد: ينتقل استهلاكه وإعداداته إلى الجهاز الذي تختاره."

msgid "Join the two devices?"
msgstr "دمج الجهازين؟"

msgid "This cannot be undone."
msgstr "لا يمكن التراجع عن ذلك."

msgid "Join"
msgstr "دمج"

msgid "Joined."
msgstr "تم الدمج."

msgctxt "Virox"
msgid "Close"
msgstr "إغلاق"

msgid "For example: Ahmed"
msgstr "مثلًا: أحمد"

msgid "People"
msgstr "الأشخاص"

msgid "Put the devices of one person together, then pause, limit or protect all of them at once."
msgstr "اجمع أجهزة كل شخص معًا، ثم أوقفها مؤقتًا أو ضع لها حدودًا أو احمِها كلها مرة واحدة."

msgid "No people yet."
msgstr "لا يوجد أشخاص بعد."

msgid "Add person"
msgstr "إضافة شخص"

msgid "All"
msgstr "الكل"

msgid "Online now"
msgstr "المتصلة الآن"

msgid "No device is connected right now."
msgstr "لا يوجد جهاز متصل الآن."

msgid "No device has been seen yet."
msgstr "لم يظهر أي جهاز بعد."

msgid "The internet is working"
msgstr "الإنترنت يعمل"

msgid "The modem answers, but the internet does not get through. The problem is at the provider or the line."
msgstr "المودم يرد، لكن الإنترنت لا يصل. المشكلة عند شركة الإنترنت أو في الخط."

msgid "The modem does not answer. Check that it is switched on and its cable is plugged in."
msgstr "المودم لا يرد. تأكد أنه يعمل وأن الكابل موصول."

msgid "No internet line: the cable to the modem is out or the line is down."
msgstr "لا يوجد خط إنترنت: كابل المودم مفصول أو الخط متوقف."

msgid "A new device joined: %s"
msgstr "انضم جهاز جديد: %s"

msgid "A new device is waiting for your approval: %s"
msgstr "جهاز جديد بانتظار موافقتك: %s"

msgid "A daily internet time is used up."
msgstr "انتهى الوقت اليومي لأحد الأجهزة."

msgid "A device is close to its usage limit."
msgstr "اقترب جهاز من حد الاستهلاك."

msgid "A device used up its usage limit and is cut until the next cycle."
msgstr "وصل جهاز إلى حد الاستهلاك، وانقطع عنه الإنترنت حتى الدورة التالية."

msgid "Most of the internet package is used."
msgstr "تم استخدام معظم باقة الإنترنت."

msgid "The internet package is used up. The provider may slow down or stop the line."
msgstr "انتهت باقة الإنترنت. قد تبطئ شركة الإنترنت الخط أو توقفه."

msgid "The internet stopped."
msgstr "انقطع الإنترنت."

msgid "The internet is back after %s."
msgstr "عاد الإنترنت بعد %s."

msgid "A filter list could not be loaded; the previous state was kept."
msgstr "تعذّر تحميل إحدى قوائم الفلتر، وبقي الوضع السابق."

msgid "The router memory is low, so a smaller filter list is used."
msgstr "ذاكرة الراوتر منخفضة، لذلك تُستخدم قائمة فلتر أصغر."

msgid "The usage count of one day does not add up; please send a help report."
msgstr "حساب الاستهلاك ليوم واحد غير متطابق. أرسل تقرير المساعدة من فضلك."

msgid "An error was stopped before it could delete data."
msgstr "تم إيقاف خطأ قبل أن يحذف بيانات."

msgid "A network setting stopped address handout; the last working settings were put back."
msgstr "أوقف أحد إعدادات الشبكة توزيع العناوين، فتمت إعادة آخر إعدادات كانت تعمل."

msgid "The package now continues from the figure of the provider."
msgstr "تكمل الباقة الآن من الرقم الذي تعرضه شركة الإنترنت."

msgid "Internet"
msgstr "الإنترنت"

msgid "Checking the line… the result appears within two minutes."
msgstr "جارٍ فحص الخط… تظهر النتيجة خلال دقيقتين."

msgid "Working"
msgstr "يعمل"

msgid "Not working"
msgstr "لا يعمل"

msgid "Line"
msgstr "الخط"

msgid "Since"
msgstr "منذ"

msgid "Connected now"
msgstr "المتصلة الآن"

msgid "1 device"
msgstr "جهاز واحد"

msgid "All devices"
msgstr "كل الأجهزة"

msgid "Package"
msgstr "الباقة"

msgid "The package size is not set, so the router cannot tell what is left."
msgstr "حجم الباقة غير محدد، لذلك لا يعرف الراوتر المتبقي منها."

msgid "Used this cycle:"
msgstr "المستخدم منذ آخر تجديد:"

msgid "Set the package"
msgstr "تحديد الباقة"

msgid "Left:"
msgstr "المتبقي:"

msgid "Renews on"
msgstr "تتجدد يوم"

msgid "Usage details"
msgstr "تفاصيل الاستهلاك"

msgid "Waiting for your approval"
msgstr "بانتظار موافقتك"

msgid "These new devices have no internet until you allow them. If one is a known phone that changed its number, open Devices and choose \"This is the same device\"."
msgstr "هذه الأجهزة الجديدة بدون إنترنت حتى تسمح لها. إذا كان أحدها هاتفًا معروفًا تغيّر رقمه، فافتح «الأجهزة» واختر «هذا هو الجهاز نفسه»."

msgid "New alerts"
msgstr "تنبيهات جديدة"

msgctxt "Virox"
msgid "Info"
msgstr "معلومة"

msgid "Note"
msgstr "ملاحظة"

msgid "Important"
msgstr "مهم"

msgid "Mark as read"
msgstr "تمييز كمقروء"

msgid "This page is for family logins."
msgstr "هذه الصفحة لحسابات أفراد العائلة."

msgid "Limit:"
msgstr "الحد:"

msgid "Online"
msgstr "متصل"

msgid "No device belongs to you yet. Ask the person who manages the router."
msgstr "لا توجد أجهزة مسجلة باسمك بعد. اسأل مَن يدير الراوتر."

msgid "Excellent"
msgstr "ممتازة"

msgid "Good"
msgstr "جيدة"

msgctxt "Virox"
msgid "Weak"
msgstr "ضعيفة"

msgid "Internet package"
msgstr "باقة الإنترنت"

msgid "Package size (GB), empty = I do not know"
msgstr "حجم الباقة (جيجا)، اتركه فارغًا إذا كنت لا تعرفه"

msgid "Renews on day"
msgstr "يوم التجديد"

msgid "The day of the month the provider renews the package."
msgstr "اليوم من الشهر الذي تجدد فيه شركة الإنترنت الباقة."

msgid "Warn me when used"
msgstr "نبّهني عند استخدام"

msgid "Change the Wi-Fi name or password"
msgstr "تغيير اسم الواي فاي أو كلمة المرور"

msgid "Wi-Fi"
msgstr "الواي فاي"

msgid "No Wi-Fi radio found."
msgstr "لم يتم العثور على واي فاي في هذا الراوتر."

msgid "5 GHz (fast, shorter reach)"
msgstr "5 جيجاهرتز (أسرع، ومداه أقصر)"

msgid "2.4 GHz (reaches further, slower)"
msgstr "2.4 جيجاهرتز (مداه أبعد، وأبطأ)"

msgid "Network name:"
msgstr "اسم الشبكة:"

msgid "Channel"
msgstr "القناة"

msgid "busy"
msgstr "مزدحمة"

msgid "Choose the best channel now?"
msgstr "اختيار أفضل قناة الآن؟"

msgid "Wi-Fi stops for about a minute while the router listens to the neighbours; devices reconnect by themselves."
msgstr "يتوقف الواي فاي نحو دقيقة بينما يفحص الراوتر شبكات الجيران، ثم تتصل الأجهزة من جديد تلقائيًا."

msgid "Choose now"
msgstr "اختيار الآن"

msgid "Choosing… Wi-Fi is back in about a minute."
msgstr "جارٍ الاختيار… يعود الواي فاي خلال دقيقة تقريبًا."

msgid "Choose the best channel now"
msgstr "اختيار أفضل قناة الآن"

msgid "Games mode"
msgstr "وضع الألعاب"

msgid "Lets game consoles and some calls open the ports they need by themselves. Leave it off unless a game asks for an \"open NAT\"."
msgstr "يسمح لأجهزة الألعاب وبعض تطبيقات المكالمات بفتح المنافذ التي تحتاجها تلقائيًا. اتركه متوقفًا إلا إذا طلبت لعبة «Open NAT»."

msgctxt "Virox"
msgid "On"
msgstr "مفعّل"

msgctxt "Virox"
msgid "Off"
msgstr "متوقف"

msgid "Games mode is off."
msgstr "تم إيقاف وضع الألعاب."

msgid "Games mode is on."
msgstr "تم تشغيل وضع الألعاب."

msgid "Family logins"
msgstr "حسابات أفراد العائلة"

msgid "A family login sees only the devices and usage of its own person, and cannot change anything. The router password is never shared."
msgstr "يرى حساب فرد من العائلة أجهزة صاحبه واستهلاكها فقط، ولا يستطيع تغيير أي شيء. ولا تُعطى كلمة مرور الراوتر لأحد."

msgid "New password"
msgstr "كلمة مرور جديدة"

msgid "Remove the login %s?"
msgstr "حذف الحساب %s؟"

msgid "It stops working at once."
msgstr "سيتوقف عن العمل فورًا."

msgid "No family login yet."
msgstr "لا توجد حسابات لأفراد العائلة بعد."

msgid "New family login"
msgstr "حساب جديد لفرد من العائلة"

msgid "Login name (small English letters and digits)"
msgstr "اسم المستخدم (حروف إنجليزية صغيرة وأرقام)"

msgid "Password (at least 8 characters)"
msgstr "كلمة المرور (8 أحرف على الأقل)"

msgid "Sees the devices of"
msgstr "يرى أجهزة"

msgid "Add a person under Devices first."
msgstr "أضف الشخص أولًا من صفحة الأجهزة (تبويب الأشخاص)."

msgid "New password for %s"
msgstr "كلمة مرور جديدة للحساب %s"

msgid "Quick setup (internet type, Wi-Fi, router password)"
msgstr "الإعداد السريع (نوع الإنترنت، الواي فاي، كلمة مرور الراوتر)"

msgid "Advanced settings (the complete menu)"
msgstr "الإعدادات المتقدمة (القائمة الكاملة)"

msgid "Cycle"
msgstr "الدورة"

msgid "Counted by the router itself:"
msgstr "حسب عدّاد الراوتر نفسه:"

msgid "corrected with the provider figure"
msgstr "مصحّح بحسب رقم شركة الإنترنت"

msgid "The provider shows a different amount left?"
msgstr "هل تعرض شركة الإنترنت رقمًا مختلفًا للمتبقي؟"

msgid "Type what the provider (its app, website or SMS) shows as remaining now. The package then continues from that figure until the next renewal."
msgstr "اكتب المتبقي الذي تعرضه شركة الإنترنت الآن (في تطبيقها أو موقعها أو رسالة SMS). تكمل الباقة بعدها من هذا الرقم حتى التجديد التالي."

msgid "Remaining at the provider (GB)"
msgstr "المتبقي لدى شركة الإنترنت (جيجا)"

msgid "Day by day"
msgstr "يومًا بيوم"

msgid "No usage in this cycle yet."
msgstr "لا يوجد استهلاك في هذه الدورة بعد."

msgid "The router itself"
msgstr "الراوتر نفسه"

msgctxt "Virox"
msgid "Unknown"
msgstr "غير معروف"

msgid "Who used what"
msgstr "استهلاك كل جهاز"

msgctxt "Virox"
msgid "Device"
msgstr "الجهاز"

msgid "\"The router itself\" is its own traffic (clock, name lookups, updates). \"Unknown\" is traffic that could not be given to a device."
msgstr "«الراوتر نفسه» هو استهلاك الراوتر الخاص (ضبط الساعة، البحث عن أسماء المواقع، التحديثات). «غير معروف» هو استهلاك لم يمكن نسبته إلى جهاز."

msgid "The router is already busy with this. Wait a moment."
msgstr "الراوتر مشغول بهذه العملية الآن. انتظر قليلًا."

msgid "The router clock is not set yet; updates can be checked once it is."
msgstr "ساعة الراوتر لم تُضبط بعد، وسيتم فحص التحديثات بعد ضبطها."

msgid "A new version is available"
msgstr "يتوفر إصدار جديد"

msgid "Version"
msgstr "الإصدار"

msgid "See and install"
msgstr "عرض وتثبيت"

msgid "The update server could not be reached. Try again later."
msgstr "تعذّر الوصول إلى خادم التحديثات. حاول لاحقًا."

msgid "The update information is not signed by Virox, so it was ignored."
msgstr "معلومات التحديث غير موقّعة من Virox، لذلك تم تجاهلها."

msgid "The downloaded update was damaged and was deleted. Try again."
msgstr "كان ملف التحديث الذي تم تحميله تالفًا وتم حذفه. حاول مرة أخرى."

msgid "The router refused this update file. Nothing was changed."
msgstr "رفض الراوتر ملف التحديث هذا. لم يتغير شيء."

msgid "The newest version is not for this router model."
msgstr "أحدث إصدار ليس لهذا الطراز من الراوتر."

msgid "Not enough free memory for the update. Restart the router and try again."
msgstr "لا توجد ذاكرة كافية للتحديث. أعد تشغيل الراوتر ثم حاول مرة أخرى."

msgid "No update server is set."
msgstr "لم يتم تحديد خادم للتحديثات."

msgid "Installed version:"
msgstr "الإصدار المثبت:"

msgid "Downloading the update…"
msgstr "جارٍ تحميل التحديث…"

msgid "Checking…"
msgstr "جارٍ الفحص…"

msgid "Installing. Do not switch the router off; it restarts by itself in a few minutes."
msgstr "جارٍ التثبيت. لا تطفئ الراوتر؛ سيُعاد تشغيله تلقائيًا خلال دقائق."

msgid "New version:"
msgstr "الإصدار الجديد:"

msgid "Install version %s?"
msgstr "تثبيت الإصدار %s؟"

msgid "Your settings are kept. The router restarts by itself and the internet stops for about five minutes. Do not switch it off meanwhile."
msgstr "تبقى إعداداتك كما هي. يُعاد تشغيل الراوتر تلقائيًا وينقطع الإنترنت نحو خمس دقائق. لا تطفئ الراوتر خلال ذلك."

msgid "Install"
msgstr "تثبيت"

msgid "Installing…"
msgstr "جارٍ التثبيت…"

msgid "Install now"
msgstr "التثبيت الآن"

msgid "This is the newest version."
msgstr "هذا أحدث إصدار."

msgid "Not checked yet."
msgstr "لم يتم الفحص بعد."

msgid "Check now"
msgstr "الفحص الآن"

msgid "Update"
msgstr "التحديث"

msgid "This file is not a Virox settings file."
msgstr "هذا الملف ليس ملف إعدادات Virox."

msgid "This file is damaged or not safe to use."
msgstr "هذا الملف تالف أو غير آمن للاستخدام."

msgid "Choose a file first."
msgstr "اختر ملفًا أولًا."

msgid "This file cannot be used."
msgstr "لا يمكن استخدام هذا الملف."

msgid "Choose 1 to 24 hours."
msgstr "اختر من 1 إلى 24 ساعة."

msgid "Restore the settings of %s?"
msgstr "استعادة إعدادات يوم %s؟"

msgid "All settings and the usage history are replaced by the ones in the file, then the router restarts (about two minutes). This router keeps its own device numbers."
msgstr "تُستبدل كل الإعدادات وسجل الاستهلاك بما في الملف، ثم يُعاد تشغيل الراوتر (نحو دقيقتين). يحتفظ الراوتر برقمه (MAC) الخاص."

msgctxt "Virox"
msgid "Restore"
msgstr "استعادة"

msgid "Restoring. The router restarts now."
msgstr "جارٍ الاستعادة. سيُعاد تشغيل الراوتر الآن."

msgid "Help report"
msgstr "تقرير المساعدة"

msgid "A file for whoever helps you: versions, line and Wi-Fi state, recent errors. Passwords, device numbers, addresses and names are removed."
msgstr "ملف لمن يساعدك: الإصدارات، وحالة الخط والواي فاي، وآخر الأخطاء. تُحذف منه كلمات المرور وأرقام الأجهزة والعناوين والأسماء."

msgid "Download the help report"
msgstr "تحميل تقرير المساعدة"

msgid "Save and restore settings"
msgstr "حفظ الإعدادات واستعادتها"

msgid "One file with all settings, devices and usage history. It contains the Wi-Fi password: keep it safe."
msgstr "ملف واحد فيه كل الإعدادات والأجهزة وسجل الاستهلاك. يحتوي على كلمة مرور الواي فاي، فاحتفظ به في مكان آمن."

msgid "Save my settings"
msgstr "حفظ إعداداتي"

msgid "Restore from a file"
msgstr "استعادة من ملف"

msgid "Nightly copies on the USB stick:"
msgstr "النسخ الليلية على ذاكرة USB:"

msgid "Plug a USB stick into the router and it keeps a copy every night (the last 14)."
msgstr "صِل ذاكرة USB بالراوتر ليحفظ نسخة كل ليلة (آخر 14 نسخة)."

msgid "Help and backup"
msgstr "المساعدة والنسخ الاحتياطي"

msgid "The internet has been down for %s"
msgstr "الإنترنت متوقف منذ %s"

msgid "The internet is down"
msgstr "الإنترنت متوقف"

msgid "Used since the last renewal: %s"
msgstr "المستخدم منذ آخر تجديد: %s"

msgid "Package used"
msgstr "المستخدم من الباقة"

msgid "Renews on %s"
msgstr "تتجدد الباقة في %s"

msgid "New devices waiting for your approval: %s"
msgstr "أجهزة جديدة بانتظار موافقتك: %s"

msgid "A new version is available: %s"
msgstr "يتوفر إصدار جديد: %s"

msgid "Devices: %s"
msgstr "الأجهزة: %s"

msgid "Sign out"
msgstr "تسجيل الخروج"

