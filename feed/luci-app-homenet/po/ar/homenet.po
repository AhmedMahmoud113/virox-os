msgstr "حجم الباقة، يوم التجديد، التنبيه"

msgid "Name and password, channels, network names"
msgstr "الاسم وكلمة المرور، القنوات، أسماء الشبكة"

msgid "Logins that see only their own devices"
msgstr "حسابات ترى أجهزتها فقط"

msgid "Open ports for game consoles"
msgstr "فتح المنافذ لأجهزة الألعاب"

msgid "Router version and updates"
msgstr "إصدار الراوتر والتحديثات"

msgid "Help report, save and restore settings"
