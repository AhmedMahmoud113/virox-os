msgid "For 2 hours"
msgstr "لمدة ساعتين"

msgid "Turn off the second line"
msgstr "إيقاف الخط الثاني"

msgid "Everyone uses the first line again, and port LAN 4 serves home devices."
msgstr "يعود الجميع إلى الخط الأول، ويخدم منفذ LAN 4 أجهزة المنزل."

msgid "Turn off the second line?"
msgstr "إيقاف الخط الثاني؟"

