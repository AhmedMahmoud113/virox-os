#!/bin/sh
# SPDX-License-Identifier: LicenseRef-PolyForm-Noncommercial-1.0.0
# Virox updater (BUILD-PLAN B8.1, section 12.5, PLAN 9.3). Manual install only.
#
#   lg7200-update check      fetch latest.json and latest.json.sig from the update server, verify the
#                            signature with a key shipped in the image, keep the result
#   lg7200-update download [<board>]  fetch this board's image named in the verified latest.json;
#                            check size + sha256. <board> = another board id (gapm7200 | gapd7200):
#                            the main router fetches the image of its access points of that board
#                            for "update all" (kept apart, never installed here)
#   lg7200-update install    check + download, then `sysupgrade -T`, then `sysupgrade` (settings kept;
#                            the router restarts). LG7200_UPDATE_DRYRUN=1: stop after -T (tests)
#   lg7200-update daily      cron: once a day, after the clock is synced, `check` (the banner)
#   lg7200-update status     the state as key=value lines
#   lg7200-update serve      (main router, update all) offer the verified latest.json, its signature
#                            and the downloaded images to the access points on the LAN, under
#                            http://<this router>/virox-update/ (RAM only, bind mount)
#   lg7200-update unserve    stop offering them
# LG7200_UPDATE_URL=<url> replaces the update server for one call: an access point updated by the
# main router fetches from it (signature and sha256 are still checked here, with this unit's own
# keys, so the main router cannot hand over anything Virox did not sign).
# Output "OK [...]" or "ERR <code>" (exit 2).
#
# latest.json (written by tools/release.sh, signed with usign):
#   { "product": "Virox", "version": "26.01.1", "boards": [ "mercury,gapm7200" ],
#     "image": { "file": "<name>-sysupgrade.bin", "sha256": "...", "size": 123 },
#     "images": [ { "board": "gapm7200", "boards": [ "mercury,gapm7200" ], "file": ..., "sha256": ..., "size": ... },
#                 { "board": "gapd7200", "boards": [ "asus,rt-ac58u" ], "file": ..., ... } ],
#     "changelog": { "ar": "...", "en": "..." } }
# One entry of "images" per board (BUILD-PLAN 16); a unit takes only the entry whose "boards" name
# its own board name, never another one. "boards" + "image" at the top stay the GAPM-7200 image:
# units from before BUILD-PLAN 16 read only those; a latest.json with "images" is read only there.
# Rules: nothing is installed without a valid signature by a key in /etc/lg7200/update-keys and a
# matching sha256; HTTPS certificates are always checked, so before the clock is synced (a router
# has no battery clock) the updater refuses with clock_not_synced instead of skipping a check;
# the request carries nothing about the user (a plain HTTP GET).
umask 077
. /lib/functions/lg7200.sh 2>/dev/null

DIR="${LG7200_UPDATE_DIR:-/tmp/lg7200-update}"     # (another folder: tests only)
KEYS=/etc/lg7200/update-keys
STATUS="$DIR/status"
mkdir -p "$DIR"

err() { echo "ERR $1"; st error "$1"; exit 2; }
st() { # key value
	[ -f "$STATUS" ] || : > "$STATUS"
	{ grep -v "^$1=" "$STATUS"; echo "$1=$2"; } > "$STATUS.new"; mv -f "$STATUS.new" "$STATUS"
}

base_url() {
	local u
	if [ -n "${LG7200_UPDATE_URL:-}" ]; then u="$LG7200_UPDATE_URL"; else u="$(uci -q get lg7200.update.url)"; fi
	echo "${u%/}"
}
board() { cat /tmp/sysinfo/board_name 2>/dev/null; }
myid() { if command -v lg7200_board >/dev/null 2>&1; then lg7200_board; else echo unknown; fi; }
# the OpenWrt board names of a Virox board id (same table as lg7200_board)
names_of() { case "$1" in gapm7200) echo mercury,gapm7200 ;; gapd7200) echo asus,rt-ac58u ;; esac; }
# sel <board name>: the jsonfilter path of the image for that OpenWrt board name in the verified
# latest.json: the "images" entry whose "boards" name it; a latest.json from before BUILD-PLAN 16
# (no "images") has one image at the top for its "boards"
sel() {
	local i=0 L="$DIR/latest.json"
	[ -n "$1" ] || return 1
	if jsonfilter -i "$L" -e '@.images' >/dev/null 2>&1; then
		while [ $i -lt 16 ] && jsonfilter -i "$L" -e "@.images[$i].file" >/dev/null 2>&1; do
			jsonfilter -i "$L" -e "@.images[$i].boards[*]" 2>/dev/null | grep -qxF "$1" && { echo "@.images[$i]"; return 0; }
			i=$((i + 1))
		done
		return 1
	fi
	jsonfilter -i "$L" -e '@.boards[*]' 2>/dev/null | grep -qxF "$1" && echo "@.image"
}
# img <file|sha256|size> [<board name>]: that board's image in the verified latest.json
img() {
	local p
	p="$(sel "${2:-$(board)}")" || return 1
	jsonfilter -i "$DIR/latest.json" -e "$p.$1" 2>/dev/null
}
current() { . /etc/lg7200-release 2>/dev/null; echo "${PRODUCT_VERSION:-0}"; }

synced() {
	command -v lg7200_time_synced >/dev/null 2>&1 || return 0
	lg7200_time_synced
}
# clock_ok: the clock matters only for HTTPS certificates. Update all hands an access point the main
# router's own copy over plain HTTP on the LAN (http://<private address>/virox-update), where the
# signature and the sha256 are the whole check: no clock needed there (2026-11-24: AP 2 had no
# internet, so no clock, and Update all stopped at it with clock_not_synced).
clock_ok() {
	case "$(base_url)" in
		http://10.*|http://192.168.*|http://172.1[6-9].*|http://172.2[0-9].*|http://172.3[01].*) return 0 ;;
	esac
	synced
}

# fetch <url> <file>: HTTPS with certificate checks, 60 s
# A file of a GitHub release (https://github.com/<owner>/<repo>/releases/download/<tag>/<name>) is
# taken through the GitHub API first: github.com's own redirect left uclient-fetch hanging
# ("Connection timed out") on the owner's line while the API and the file host answered
# (2.230, 2026-11-22). The release list is kept for 10 minutes (the API allows 60 calls an hour).
gh_fetch() { # <url> <file>
	local rest repo tag name list u
	rest="${1#https://github.com/}"
	repo="$(echo "$rest" | cut -d/ -f1-2)"; tag="$(echo "$rest" | cut -d/ -f5)"; name="$(echo "$rest" | cut -d/ -f6-)"
	[ -n "$repo" ] && [ -n "$tag" ] && [ -n "$name" ] || return 1
	case "$name" in */*) return 1 ;; esac
	list="$DIR/github-$tag.json"
	# the GitHub API allows 60 requests an hour for the whole house (one public address); after a
	# refusal (HTTP 403 when they are used up) it is left alone for 10 minutes: retries every minute by
	# several units used it up and kept it used up (update all to 0.9.0-rc4.2, 2026-11-23)
	if [ -f "$DIR/api-refused" ] && [ $(( $(date +%s) - $(date -r "$DIR/api-refused" +%s 2>/dev/null || echo 0) )) -lt 600 ]; then
		return 1
	fi
	if [ ! -s "$list" ] || [ $(( $(date +%s) - $(date -r "$list" +%s 2>/dev/null || echo 0) )) -gt 600 ]; then
		uclient-fetch -q -T 60 -O "$list" "https://api.github.com/repos/$repo/releases/tags/$tag" 2>/dev/null || { rm -f "$list"; : > "$DIR/api-refused"; return 1; }
	fi
	u="$(jsonfilter -i "$list" -e "@.assets[@.name=\"$name\"].url" 2>/dev/null | head -n 1)"
	[ -n "$u" ] || return 1
	uclient-fetch -q -T 60 --header='Accept: application/octet-stream' -O "$2" "$u" 2>/dev/null && [ -s "$2" ] && { rm -f "$DIR/api-refused"; return 0; }
	: > "$DIR/api-refused"; return 1
}
fetch() {
	rm -f "$2"
	case "$1" in https://github.com/*/releases/download/*/*) gh_fetch "$1" "$2" && return 0; rm -f "$2" ;; esac
	uclient-fetch -q -T 60 -O "$2" "$1" 2>/dev/null && [ -s "$2" ]
}

# version compare: newer <a> <b> -> exit 0 when a > b. "26.01.1" style numbers; "-rcN" is older
# than the release of the same number; "-rcN.M" is a fix of rcN (owner 2026-11-22: 0.9.0-rc3.1),
# newer than rcN and older than rcN+1. (An rc3 unit with the old compare also takes rc3.1 as newer.)
newer() {
	awk -v a="$1" -v b="$2" '
		function split_v(v, p,   r, f, n, i, q) { r = 99999; f = 0
			if (match(v, /-rc[0-9]+(\.[0-9]+)?$/)) { q = substr(v, RSTART + 3); v = substr(v, 1, RSTART - 1)
				r = q + 0; if (index(q, ".")) f = substr(q, index(q, ".") + 1) + 0 }
			n = split(v, p, "."); for (i = n + 1; i <= 4; i++) p[i] = 0; p[5] = r; p[6] = f; return n }
		BEGIN { split_v(a, x); split_v(b, y); for (i = 1; i <= 6; i++) { if (x[i] + 0 > y[i] + 0) exit 0; if (x[i] + 0 < y[i] + 0) exit 1 } exit 1 }'
}

check() {
	local u
	clock_ok || err clock_not_synced
	u="$(base_url)"
	[ -n "$u" ] || err no_update_server
	st checked "$(date +%s)"
	fetch "$u/latest.json" "$DIR/latest.json.new" || err download_failed
	fetch "$u/latest.json.sig" "$DIR/latest.json.new.sig" || err download_failed
	# usign looks the key up by the fingerprint written in the signature
	usign -V -q -P "$KEYS" -m "$DIR/latest.json.new" -x "$DIR/latest.json.new.sig" 2>/dev/null || {
		rm -f "$DIR/latest.json.new" "$DIR/latest.json.new.sig"
		logger -t lg7200-update "latest.json: bad or unknown signature, ignored"
		err bad_signature
	}
	mv -f "$DIR/latest.json.new" "$DIR/latest.json"; mv -f "$DIR/latest.json.new.sig" "$DIR/latest.json.sig"
	v="$(jsonfilter -i "$DIR/latest.json" -e '@.version' 2>/dev/null)"
	[ -n "$v" ] || err bad_latest
	# this board's own image only (BUILD-PLAN 16: never an image of the other board)
	if ! sel "$(board)" >/dev/null; then
		st available ""; st latest "$v"; st error wrong_board; echo "ERR wrong_board"; exit 2
	fi
	st latest "$v"; st error ""
	if newer "$v" "$(current)"; then st available "$v"; echo "OK $v"; else st available ""; echo "OK none"; fi
}

download() {
	local f sum size got b="${1:-$(myid)}" bn out="$DIR/image.bin" name="$DIR/image.name"
	[ -s "$DIR/latest.json" ] || err not_checked
	# the stored latest.json is verified again: a file left in /tmp is never trusted by itself
	usign -V -q -P "$KEYS" -m "$DIR/latest.json" -x "$DIR/latest.json.sig" 2>/dev/null || err bad_signature
	# another board's image (update all, for the access points): kept apart, never installed here
	bn="$(board)"
	if [ "$b" != "$(myid)" ]; then
		echo "$b" | grep -qE '^[a-z0-9]+$' || err bad_board
		bn="$(names_of "$b")"; [ -n "$bn" ] || err bad_board
		mkdir -p "$DIR/other"; out="$DIR/other/$b.bin"; name="$DIR/other/$b.name"
	fi
	f="$(img file "$bn")"; sum="$(img sha256 "$bn")"; size="$(img size "$bn")"
	[ -n "$f" ] || err no_image
	case "$f" in /*|*..*) err bad_latest ;; esac
	echo "$sum" | grep -Eq '^[0-9a-f]{64}$' || err bad_latest
	clock_ok || err clock_not_synced
	# enough room in RAM for the image (+ 16 MB to spare)
	[ "$(awk '/^MemAvailable:/ { print $2 }' /proc/meminfo)" -gt $(( ${size:-0} / 1024 + 16384 )) ] || err no_space
	st downloading "$(date +%s)"
	fetch "$(base_url)/$f" "$out" || { st downloading ""; err download_failed; }
	st downloading ""
	got="$(wc -c < "$out")"
	[ -z "$size" ] || [ "$got" = "$size" ] || { rm -f "$out"; err bad_image; }
	[ "$(sha256sum "$out" | cut -d' ' -f1)" = "$sum" ] || { rm -f "$out"; logger -t lg7200-update "image sha256 mismatch, deleted"; err bad_image; }
	echo "$f" > "$name"
	echo OK
}

# main router, update all: the access points fetch the update from here (one download for the house)
WWW=/www/virox-update
serve() {
	local f
	[ -s "$DIR/image.bin" ] && [ -s "$DIR/image.name" ] || err not_downloaded
	f="$(cat "$DIR/image.name")"
	# the old share only: unserve also deletes other/, the other board's images just downloaded for the
	# access points, so a GAPD-7200 under a GAPM-7200 never found its image (update all, 2026-11-23)
	if grep -q " $WWW " /proc/mounts; then umount "$WWW"; fi
	rm -rf "$DIR/pub"; mkdir -p "$DIR/pub/$(dirname "$f")"
	ln -f "$DIR/latest.json" "$DIR/pub/latest.json"; ln -f "$DIR/latest.json.sig" "$DIR/pub/latest.json.sig"
	ln -f "$DIR/image.bin" "$DIR/pub/$f"
	chmod 755 "$DIR" "$DIR/pub" "$DIR/pub/$(dirname "$f")"
	chmod 644 "$DIR/pub/latest.json" "$DIR/pub/latest.json.sig" "$DIR/pub/$f"
	# the images of the other board downloaded for the access points (BUILD-PLAN 16)
	for o in "$DIR"/other/*.name; do
		[ -s "$o" ] && [ -s "${o%.name}.bin" ] || continue
		f="$(cat "$o")"
		case "$f" in /*|*..*) continue ;; esac
		mkdir -p "$DIR/pub/$(dirname "$f")"; chmod 755 "$DIR/pub/$(dirname "$f")"
		ln -f "${o%.name}.bin" "$DIR/pub/$f"; chmod 644 "$DIR/pub/$f"
	done
	mkdir -p "$WWW"
	mount --bind "$DIR/pub" "$WWW" || err serve_failed
	echo OK
}
unserve() {
	if grep -q " $WWW " /proc/mounts; then umount "$WWW"; fi
	rm -rf "$DIR/pub" "$DIR/other"
	echo OK
}

install() {
	local out
	# (the reason of a failed step is printed; "OK ..." of the steps is not)
	out="$(check)" || { echo "$out"; exit 2; }
	[ -n "$(sed -n 's/^available=//p' "$STATUS")" ] || err no_update
	out="$(download)" || { echo "$out"; exit 2; }
	# made for this board? (GAPM-7200 / GAPD-7200, BUILD-PLAN 16) the signed latest.json already
	# names it; the image's own metadata is checked too, so a wrong entry can never be installed
	if command -v lg7200_image_for_board >/dev/null 2>&1 && ! out="$(lg7200_image_for_board "$DIR/image.bin")"; then
		rm -f "$DIR/image.bin"
		logger -t lg7200-update "the image is for $out, not for $(board): refused"
		err wrong_board_image
	fi
	if ! out="$(sysupgrade -T "$DIR/image.bin" 2>&1)"; then
		logger -t lg7200-update "sysupgrade -T refused the image: $out"
		err image_refused
	fi
	if [ "${LG7200_UPDATE_DRYRUN:-0}" = 1 ]; then echo "OK dryrun"; return 0; fi
	# a copy of the settings on the router itself first (owner 2026-11-22): if the new version
	# misbehaves, Settings, Help and backup puts them back. A failed copy is logged, not fatal.
	if [ -x /usr/libexec/lg7200/backup ]; then
		out="$(/usr/libexec/lg7200/backup preupdate "$(current)" "$(sed -n 's/^available=//p' "$STATUS")" 2>&1)" ||
			logger -t lg7200-update "the settings copy before the update failed: $out"
	fi
	lg7200_event_add system update_installing info version="$(sed -n 's/^available=//p' "$STATUS")" >/dev/null 2>&1
	st installing "$(date +%s)"
	echo "OK installing"
	# settings are kept (no -n); -P makes the protected storage (the provisioning volume, BUILD-PLAN
	# B6 item 1) on its first use, so the unit's name, Wi-Fi password and MAC survive a factory
	# reset from then on; the router restarts when the image is written
	( sleep 2; sysupgrade -P "$DIR/image.bin" ) >/dev/null 2>&1 &
}

daily() {
	local today last
	synced || exit 0
	today="$(date +%F)"; last="$(sed -n 's/^checked_day=//p' "$STATUS" 2>/dev/null)"
	[ "$last" = "$today" ] && exit 0
	st checked_day "$today"
	check >/dev/null 2>&1
	v="$(sed -n 's/^available=//p' "$STATUS")"
	if [ -n "$v" ] && [ "$(sed -n 's/^announced=//p' "$STATUS")" != "$v" ]; then
		st announced "$v"
		lg7200_event_add system update_available info version="$v" >/dev/null 2>&1
	fi
	exit 0
}

exec 9>"$DIR.lock"
case "$1" in
	daily) flock -n 9 || exit 0 ;;
	*) flock -n 9 || err busy ;;
esac
case "$1" in
	check) check ;;
	download) download "$2" ;;
	install) install ;;
	daily) daily ;;
	status) cat "$STATUS" 2>/dev/null; echo "current=$(current)"; echo "board=$(myid)" ;;
	serve) serve ;;
	unserve) unserve ;;
	newer) newer "$2" "$3" ;;          # for tests
	*) echo "usage: $0 check|download [<board>]|install|daily|status|serve|unserve" >&2; exit 1 ;;
esac
