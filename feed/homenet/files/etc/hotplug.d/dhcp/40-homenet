# DHCP lease changed (dnsmasq): fold what the IP used so far to its previous owner, then hand
# the IP to the new owner (BUILD-PLAN B7.5a: IP change, swap and reuse are booked correctly).
[ "$(uci -q get homenet.main.enabled)" = 0 ] && exit 0
case "$ACTION" in add|update|remove) ;; *) exit 0 ;; esac
[ -n "$MACADDR" ] && [ -n "$IPADDR" ] || exit 0
# guests (B9 Y2) are not home devices: no record, their usage is booked to "guest"
[ "${DNSMASQ_INTERFACE:-}" = br-guest ] && exit 0
/usr/libexec/homenet/accounting lease "$ACTION" "$MACADDR" "$IPADDR"
# B9 R5: DHCP fingerprint, automatic linking of a phone that came back with a new address
[ "$ACTION" = remove ] || /usr/libexec/homenet/identity dhcp "$MACADDR" "$HOSTNAME"
