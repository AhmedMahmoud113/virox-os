#!/bin/sh
# SPDX-License-Identifier: LicenseRef-PolyForm-Noncommercial-1.0.0
# Wi-Fi power and channel limits (BUILD-PLAN section 13, 15.2; owner 2026-11-22: 25 dBm is the base).
#
#   wifi-power apply [reload]   set country, txpower caps and the 5 GHz channel list of every radio
#   wifi-power check            one line per radio: name band country channel [channels] txpower
#
# Rules (owner 2026-11-22, on the owner's own responsibility: "the 20 is gone, 25 is the base"):
#  - every radio always uses the US rules, so 2.4 GHz runs at the card's top, 25 dBm (the card's
#    factory calibration; the US rules would allow 30). lg7200.wifi.power is no longer read.
#  - 5 GHz: channels 36-64 only (phones that follow the Egyptian rules do not see 100 and up),
#    the automatic choice list 36-48 (no radar wait): 23 dBm; a fixed 52-64: 24 dBm.
#  - A lower level set by the owner for an access point (apctl: medium 17, low 14) is kept.
#  - Called at every boot (wifi-defaults, when the radios appear), so the saved setting and the
#    radios never differ (2.230 had the switch on but ran 20 dBm, 2026-11-22).
. /lib/functions.sh

in_range() { [ "$1" -ge "$2" ] 2>/dev/null && [ "$1" -le "$3" ] 2>/dev/null; }

# a radio with a Wi-Fi client on it (internet from Wi-Fi, repeater, join): it follows the channel of
# the router above (apctl radio_follow), so its channel and list are not touched here; before this,
# every boot put a client's channel above 64 back to automatic and the client lost its router
has_client() {
	local s
	for s in $(uci -q show wireless | sed -n "s/^wireless\.\([^.]*\)\.device='$1'$/\1/p"); do
		[ "$(uci -q get wireless.$s.mode)" = sta ] && [ "$(uci -q get wireless.$s.disabled)" != 1 ] && return 0
	done
	return 1
}

_radio() {
	local s="$1" band ch chs tx new_chs c hi=64
	band="$(uci -q get wireless.$s.band)"
	uci set wireless.$s.country="$country"
	[ "$band" = 5g ] || return 0
	has_client "$s" && return 0
	ch="$(uci -q get wireless.$s.channel)"
	tx="$(uci -q get wireless.$s.txpower)"
	# the automatic choice list: 36-64 (36-48 under other rules than EG), never empty
	[ "$country" = EG ] || hi=48
	chs="$(uci -q get wireless.$s.channels)"
	new_chs=""
	for c in $chs; do
		case "$c" in *-*) c="${c%-*}" ;; esac
		in_range "$c" 36 $hi && new_chs="$new_chs $c"
	done
	new_chs="${new_chs# }"
	[ -n "$new_chs" ] || new_chs="36 40 44 48"
	[ "$new_chs" = "$chs" ] || uci set wireless.$s.channels="$new_chs"
	# a fixed channel above 64 is never used: back to the automatic choice
	case "$ch" in auto|'') ch=auto ;; *) in_range "$ch" 36 64 || { uci set wireless.$s.channel=auto; ch=auto; } ;; esac
	# the old 20 dBm cap on 52-64 (before 2026-11-22) is dropped: the card goes to 24 there
	if [ "$(uci -q get wireless.$s.lg7200_txcap)" = 1 ]; then
		uci -q delete wireless.$s.txpower
		uci -q delete wireless.$s.lg7200_txcap
	fi
}

apply() {
	[ -f /etc/config/wireless ] || return 0
	country=US
	config_load wireless
	config_foreach _radio wifi-device
	if [ -n "$(uci -q changes wireless)" ]; then
		uci commit wireless
		[ "${1:-}" = reload ] && wifi reload >/dev/null 2>&1
	fi
	return 0
}

check() {
	local s
	for s in $(uci -q show wireless | sed -n "s/^wireless\.\([^.]*\)=wifi-device$/\1/p"); do
		echo "$s $(uci -q get wireless.$s.band) $(uci -q get wireless.$s.country) $(uci -q get wireless.$s.channel) [$(uci -q get wireless.$s.channels)] $(uci -q get wireless.$s.txpower)"
	done
}

case "$1" in
	apply) apply "$2" ;;
	check) check ;;
	*) echo "usage: $0 apply [reload] | check" >&2; exit 1 ;;
esac
