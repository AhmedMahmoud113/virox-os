# Small safety loop (BUILD-PLAN B7.5b), run by procd (/etc/init.d/lg7200-watch):
# every 15 s the DHCP guard and the time fallback.
while :; do
	/usr/libexec/lg7200/dhcp-guard check >/dev/null 2>&1
	/usr/libexec/lg7200/time-fallback check >/dev/null 2>&1
	sleep 15
done
