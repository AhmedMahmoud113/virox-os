#!/bin/sh
# SPDX-License-Identifier: LicenseRef-PolyForm-Noncommercial-1.0.0
# Section 13 Wi-Fi defaults, once per radio (wireless.<radio>.lg7200_defaults=1), with the unit's
# own name and key (unitcfg) on access-point interfaces that still carry OpenWrt's name.
# Called by 90-lg7200-identity at first boot AND by hotplug ieee80211 (30-lg7200-wifi-defaults)
# after 10-wifi-detect: on the real unit the MT7615 (PCIe, firmware load) appears after the
# uci-defaults ran, so /etc/config/wireless did not exist yet and the Wi-Fi stayed off with
# OpenWrt's settings (first hardware unit, 2026-11-20). Never touches a radio done before, so
# the owner's own changes stay.
. /lib/functions.sh
. /lib/functions/lg7200.sh
[ -f /etc/config/wireless ] || exit 0
country="$(uci -q get lg7200.product.country)"
wifi_on="$(uci -q get lg7200.product.wifi_default_on)"
ssid="$(unitcfg_get wifi_ssid 2>/dev/null)"
key="$(unitcfg_get wifi_key 2>/dev/null)"
# before 90-lg7200-identity made the unit's name and key: nothing yet (identity calls again)
[ -n "$ssid" ] && [ -n "$key" ] || exit 0
changed=0

# legal power (regdb decides, no txpower), no 802.11b/low legacy rates, 2.4 GHz HT20 on 1/6/11,
# 5 GHz VHT80 on 36-48 without DFS, automatic channel choice (ACS) at start
_radio() {
	[ "$(uci -q get wireless.$1.lg7200_defaults)" = 1 ] && return 0
	uci set wireless.$1.country="${country:-EG}"
	uci -q delete wireless.$1.txpower
	uci set wireless.$1.legacy_rates=0
	uci set wireless.$1.channel=auto
	case "$(uci -q get wireless.$1.band)" in
		2g) uci set wireless.$1.htmode=HT20; uci set wireless.$1.channels='1 6 11' ;;
		5g) uci set wireless.$1.htmode=VHT80; uci set wireless.$1.channels='36 40 44 48'; uci set wireless.$1.acs_exclude_dfs=1 ;;
	esac
	[ "$wifi_on" = "1" ] && uci set wireless.$1.disabled=0
	uci set wireless.$1.lg7200_defaults=1
	newradio="$newradio $1"; changed=1
}
# one name on both bands; WPA2/WPA3; WPS off (12.4); 802.11k + BSS transition for usteer;
# 802.11r stays off until it is tested with real phones (B9). 25.12 generates the interfaces
# disabled: with Wi-Fi on by default (Q5) the interface is enabled too.
_iface() {
	local dev; dev="$(uci -q get wireless.$1.device)"
	case " $newradio " in *" $dev "*) ;; *) return 0 ;; esac
	[ "$(uci -q get wireless.$1.mode)" = "ap" ] || return 0
	if [ "$(uci -q get wireless.$1.ssid)" = OpenWrt ] && [ -n "$ssid" ] && [ -n "$key" ]; then
		uci set wireless.$1.ssid="$ssid"
		# WPA2 only (owner 2026-11-22: WPA2/WPA3 mixed kept the iPhone and many devices out)
		uci set wireless.$1.encryption=psk2+ccmp
		uci set wireless.$1.key="$key"
	fi
	uci -q delete wireless.$1.wds
	uci set wireless.$1.wps_pushbutton=0
	uci set wireless.$1.ieee80211k=1
	uci set wireless.$1.bss_transition=1
	[ "$wifi_on" = "1" ] && uci set wireless.$1.disabled=0
}
newradio=""
config_load wireless
config_foreach _radio wifi-device
[ -n "$newradio" ] && config_foreach _iface wifi-iface
if [ "$changed" = 1 ]; then
	uci commit wireless
	[ "${1:-}" = reload ] && wifi reload
fi
# the power rules (25 dBm base, owner 2026-11-22) at every boot, so the radios always follow them
[ -x /usr/libexec/lg7200/wifi-power ] && /usr/libexec/lg7200/wifi-power apply "${1:-}"
exit 0
