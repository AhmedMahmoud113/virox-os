# B9: a line came up or went down: its routing table and the line sets follow.
case "$INTERFACE" in wan|wan2) ;; *) exit 0 ;; esac
case "$ACTION" in ifup|ifdown|ifupdate) ;; *) exit 0 ;; esac
[ "$(uci -q get lines.main.enabled)" = 1 ] || exit 0
/usr/libexec/homenet/lines apply >/dev/null 2>&1 &
