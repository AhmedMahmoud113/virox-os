#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: LicenseRef-PolyForm-Noncommercial-1.0.0
# Two internet lines (B9): routing and sets at boot, line health watch while enabled.
START=96
USE_PROCD=1

start_service() {
	/usr/libexec/homenet/lines apply
	[ "$(uci -q get lines.main.enabled)" = 1 ] || return 0
	procd_open_instance
	procd_set_param command /usr/libexec/homenet/lines watch
	procd_set_param respawn
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger lines
}
