{#
 Virox: our footer (based on OpenWrt, the source link, credit to Vantage; no "·" joins, 10a item 2),
 the Virox menu script and the shared Virox page scripts. tools/vantage-patch.py.
 Vantage theme - footer.
 Versions are shortened to what a person reads: "OpenWrt 25.12.3 · LuCI 26.124"
 (no git describe noise such as "(HEAD detached at …) branch" or "~hash"),
 entity-encoded, and only shown to logged-in users: error pages reach
 anonymous visitors too. The menu script is only loaded for a session.
 (The core header's L.env script still carries the LuCI build for
 everyone; see docs/luci-contract.md section 2.)
-#}
{% if (blank_page): %}
</div>
{% else %}
		</main>
{%
	const dist_ver = match(version.distversion ?? '', /^[0-9A-Za-z][0-9A-Za-z.+-]*/);
	const luci_name = match(version.luciname ?? '', /^[A-Za-z][A-Za-z0-9]*/);
	const luci_ver = match(version.luciversion ?? '', /[0-9]+\.[0-9]+/);
-%}
		<footer class="vt-foot">
{% if (ctx.authsession): %}
			<span class="vx-footer">
				<span>{{ version.distname }} <bdi dir="ltr">{{ version.distversion }}</bdi></span>
				<span>{{ _('based on') }} <a href="https://openwrt.org" target="_blank" rel="noreferrer">OpenWrt</a></span>
				<a href="{{ entityencode(version.disturl ?? '#', true) }}" target="_blank" rel="noreferrer">{{ _('Source code') }}</a>
				<span>{{ _('Look based on') }} <a href="https://github.com/anothaDev/luci-theme-vantage" target="_blank" rel="noreferrer">Vantage</a></span>
				<span><bdi dir="ltr">© 2026 Ahmed Mahmoud</bdi></span>
			</span>
{% endif %}
		</footer>
	</div>
</div>
{% endif %}
{% if (ctx.authsession && !blank_page): %}
<script>L.require('menu-virox-vantage');</script>
{% include('themes/virox/scripts') %}
{% endif %}
</body>
</html>
